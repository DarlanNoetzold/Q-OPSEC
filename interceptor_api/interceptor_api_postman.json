          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://192.168.18.18:8080/actuator/health",
              "protocol": "http",
              "host": ["192.168.18.18"],
              "port": "8080",
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://192.168.18.18:8080/actuator/prometheus",
              "protocol": "http",
              "host": ["192.168.18.18"],
              "port": "8080",
              "path": ["actuator", "prometheus"]
