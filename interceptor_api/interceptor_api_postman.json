    {
      "name": "Interception",
      "item": [
        {
          "name": "Intercept Payload - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.globals.set(\"last_interceptor_req_id\", \"QA-INTERCEPT-\" + Date.now());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"anyRequestId\": \"QA-INTERCEPT-{{$timestamp}}\",\n    \"sourceIp\": \"192.168.18.50\",\n    \"destinationIp\": \"192.168.18.18\",\n    \"payload\": \"SGVsbG8gUWhEIERhcmxhbiwgUUlTUC1PUFNFQyBJbnRlcmNlcHRpb24gVGVzdA==\",\n    \"protocol\": \"HTTPS\",\n    \"port\": 443\n}"
            },
            "url": {
              "raw": "http://192.168.18.18:8080/intercept",
              "protocol": "http",
              "host": ["192.168.18.18"],
              "port": "8080",
              "path": ["intercept"]
            }
          }
        },
        {
          "name": "Get Intercepted Message",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://192.168.18.18:8080/intercept/message?request_id={{last_interceptor_req_id}}",
              "protocol": "http",
              "host": ["192.168.18.18"],
              "port": "8080",
              "path": ["intercept", "message"],
              "query": [
                {
                  "key": "request_id",
                  "value": "{{last_interceptor_req_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Payload Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://192.168.18.18:8080/intercept/payload?request_id={{last_interceptor_req_id}}",
              "protocol": "http",
              "host": ["192.168.18.18"],
              "port": "8080",
              "path": ["intercept", "payload"],
              "query": [
                {
                  "key": "request_id",
                  "value": "{{last_interceptor_req_id}}"
                }
              ]
            }
          }
        }
      ]
    },
