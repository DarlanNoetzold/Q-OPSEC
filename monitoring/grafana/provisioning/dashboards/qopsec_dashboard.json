            "panels": [],
            "title": "PIPELINE THROUGHPUT & LATENCY",
            "type": "row"
        },
        {
            "title": "Requests per Second (Python & Java)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total[1m])) by (job)",
                    "legendFormat": "Python: {{job}}",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (job)",
                    "legendFormat": "Java: {{job}}",
                    "refId": "B"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "mean",
                        "max"
                    ]
                }
            }
        },
        {
            "title": "Service Latency (p95)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, job)) * 1000",
                    "legendFormat": "{{job}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms"
                }
            }
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 14
            },
            "id": 102,
            "panels": [],
            "title": "INTELLIGENCE LAYER (RL, RISK, CONFIABILITY)",
            "type": "row"
        },
        {
            "title": "Average Risk Score Tendency",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 15
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "avg(risk_score_gauge) or avg(risk_score_predicted)",
                    "legendFormat": "Risk Level",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "max": 1,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.4
                            },
                            {
                                "color": "red",
                                "value": 0.7
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Algorithm Selections (RL Engine)",
            "type": "piechart",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 15
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rl_algorithm_selection_total) by (algorithm)",
                    "legendFormat": "{{algorithm}}",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Confiability vs Security Levels",
            "type": "barchart",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 15
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "avg(trust_score_gauge) by (security_level)",
                    "legendFormat": "Level: {{security_level}}",
                    "refId": "A"
                }
            ]
        }
