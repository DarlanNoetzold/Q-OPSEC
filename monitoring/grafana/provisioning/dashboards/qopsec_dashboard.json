        {
            "title": "Request Rate by Service",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (job)",
                    "legendFormat": "{{job}}",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (job)",
                    "legendFormat": "Spring: {{job}}",
                    "refId": "B"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "mean",
                        "max"
                    ]
                }
            }
        },
        {
            "title": "Avg Latency (ms) - Intelligence Layer",
            "type": "gauge",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "avg(rate(http_request_duration_seconds_sum{job=~\"risk.*|confiab.*|rl.*\"}[5m]) / rate(http_request_duration_seconds_count{job=~\"risk.*|confiab.*|rl.*\"}[5m])) * 1000",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 150
                            },
                            {
                                "color": "red",
                                "value": 400
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Risk & Trust Correlation",
            "type": "timeseries",
            "gridPos": {
                "h": 10,
                "w": 24,
                "x": 0,
                "y": 14
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "avg(risk_score_gauge) by (job)",
                    "legendFormat": "Risk Score",
                    "refId": "A"
                },
                {
                    "expr": "avg(trust_score_gauge) by (job)",
                    "legendFormat": "Trust Score",
                    "refId": "B"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right"
                }
            }
        }
