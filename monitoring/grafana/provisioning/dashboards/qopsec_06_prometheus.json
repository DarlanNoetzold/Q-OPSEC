  "uid": "qopsec-prometheus",
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "editable": true,
  "tags": [
    "q-opsec",
    "prometheus",
    "infra"
  ],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "30s",
  "annotations": {
    "list": []
