{
  "title": "Q-OPSEC | Database – HikariCP & JDBC",
  "uid": "qopsec-database",
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "editable": true,
  "tags": [
    "q-opsec",
    "database",
    "hikari",
    "jdbc"
