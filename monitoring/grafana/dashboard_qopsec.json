{
  "dashboard": {
    "id": null,
    "title": "Q-OPSEC Executive Ecosystem",
    "tags": ["q-opsec", "phd"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Service Health Status",
        "type": "stat",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "targets": [
          {"expr": "up{job='q-opsec'}", "legendFormat": "{{module}}"}
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "OFFLINE", "color": "red"}, "1": {"text": "ONLINE", "color": "green"}}}
            ]
          }
        }
      },
      {
        "title": "Request Rate (RPS)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {"expr": "rate(http_request_duration_seconds_count[1m])", "legendFormat": "{{module}}"}
        ]
      },
      {
        "title": "API Latency (95th Percentile)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, module))", "legendFormat": "{{module}}"}
        ]
      }
    ],
    "refresh": "5s"
  }
}