FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY common ./common
COPY orchestrator_linux.py ./orchestrator_linux.py
COPY services.yaml ./services.yaml
COPY dashboard.html ./dashboard.html

RUN useradd --system --uid 10001 --create-home qopsec \
    && mkdir -p /app/logs \
    && chown -R qopsec:qopsec /app
USER qopsec

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8081/architecture/status || exit 1

CMD ["uvicorn", "orchestrator_linux:APP", "--host", "0.0.0.0", "--port", "8081", "--workers", "1"]
